{
  "name": "virtual-tavern",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "decks:manifest": "node scripts/generate-deck-manifest.mjs",
    "prestart": "npm run decks:manifest",
    "start": "ng serve",
    "prebuild": "npm run decks:manifest",
    "build": "ng build",
    "prebuild:pages": "npm run decks:manifest",
    "build:pages": "ng build --base-href /virtual-tavern/ && node -e \"require('fs').copyFileSync('dist/virtual-tavern/browser/index.html','dist/virtual-tavern/browser/404.html')\"",
    "prewatch": "npm run decks:manifest",
    "watch": "ng build --watch --configuration development",
    "test": "ng test"
  },
  "private": true,
  "packageManager": "npm@10.5.2",
  "dependencies": {
    "@angular/common": "^22.0.0",
    "@angular/compiler": "^22.0.0",
    "@angular/core": "^22.0.0",
    "@angular/forms": "^22.0.0",
    "@angular/platform-browser": "^22.0.0",
    "@angular/router": "^22.0.0",
    "@supabase/supabase-js": "^2.110.7",
    "rxjs": "~7.8.0",
    "three": "^0.185.0",
    "trystero": "^0.25.2",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.0.4",
    "@angular/cli": "^22.0.4",
    "@angular/compiler-cli": "^22.0.0",
    "@types/three": "^0.185.0",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "vitest": "^4.0.8"
  }
}
